# ==============================================================================
# GoDude Enterprise Admin Panel — Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.
# ==============================================================================

# Existing GoDude Google Cloud VM PostgreSQL + PostGIS database
# Use 127.0.0.1:15432 when connected via scripts/tunnel-vm-db.sh (SSH tunnel to godude-prod-vm),
# or 127.0.0.1:5432 when hosted directly on the GoDude Google Cloud VM.
DATABASE_URL=postgres://godude:YOUR_VM_POSTGRES_PASSWORD@127.0.0.1:15432/godude

# Existing GoDude Google Cloud VM Backend API URL
GODUDE_API_URL=https://api.godude.rodeo

# Must match GoDude VM backend JWT_ACCESS_SECRET so signed admin service tokens validate cleanly
JWT_ACCESS_SECRET=replace_with_vm_jwt_access_secret_at_least_32_chars

# Secret key for signing Admin Panel HttpOnly session cookies (>= 32 chars)
ADMIN_SESSION_SECRET=replace_with_random_admin_session_secret_at_least_32_chars

# Primary Administrator Allowlist (Login-Only — No Public Sign-Up)
# Generate scrypt hash via:
# node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');const h=c.scryptSync('YourStrongPassword!',s,64).toString('hex');console.log('scrypt:'+s+':'+h)"
ADMIN_EMAIL=admin@godude.lk
ADMIN_PASSWORD_HASH=scrypt:replace_salt:replace_hash
ADMIN_FULL_NAME=GoDude Operations Admin

# Optional JSON array of additional authorized admin accounts:
# ADMIN_ACCOUNTS_JSON=[{"email":"ops@godude.lk","passwordHash":"scrypt:salt:hash","fullName":"Ops Lead"}]
